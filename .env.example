# Скопируйте файл в .env и заполните нужное. Все переменные необязательны:
# без них сайт работает в локальном режиме — прогресс хранится в браузере.

# Адрес сайта без слеша в конце. Нужен для карты сайта, канонических ссылок
# и ссылок в письмах входа. Пример: https://algoscope.ru
VITE_SITE_URL=

# Облачный режим (аккаунты, синхронизация, классы, приём заявок).
# Settings → API в панели Supabase: Project URL и ключ anon public.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Вход через внешние сервисы, через запятую: google, github.
# Провайдер нужно также включить в Supabase: Authentication → Providers.
VITE_AUTH_PROVIDERS=

# Контактная почта: показывается в документах и используется для заявок,
# если облако не подключено (откроется письмо в почтовой программе).
VITE_CONTACT_EMAIL=

# Оператор персональных данных и правообладатель — для политики и условий.
# Пример: ООО «Алгоскоп», ИНН 0000000000
VITE_LEGAL_ENTITY=
